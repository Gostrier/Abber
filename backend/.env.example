DB_HOST=localhost
DB_URL=jdbc:postgresql://localhost:5432/abber
DB_PORT=5432
DB_NAME=abber
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Generate a fresh 64-byte base64 secret with:
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
JWT_SECRET=change-me-with-a-64-byte-base64-secret

SERVER_PORT=8081

# SMTP credentials for the email account owned by your project team.
MAIL_USERNAME=your-smtp-user@example.com
MAIL_PASSWORD=your-smtp-password
