DB_HOST=localhost
DB_URL=jdbc:postgresql://localhost:5432/abber
DB_PORT=5432
DB_NAME=abber
DB_USERNAME=postgres
DB_PASSWORD=change-me

JWT_SECRET=change-me-with-a-64-byte-base64-secret

SERVER_PORT=8081

# Default admin account seeded on startup (password must be at least 8 chars).
# Leave ADMIN_PASSWORD empty to skip seeding.
ADMIN_EMAIL=admin@abber.local
ADMIN_PASSWORD=change-me-strong-password

MAIL_USERNAME=your-smtp-user@example.com
MAIL_PASSWORD=your-smtp-password

# Frontend URL used in verification/reset-password email links
APP_FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
